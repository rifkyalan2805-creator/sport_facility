# PostgreSQL connection used by Prisma (introspeksi & runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sports_facility?schema=public"

PORT=3000
NODE_ENV=development

# Auth / JWT — WAJIB diisi, tanpa default. Aplikasi akan gagal-cepat (exit) jika:
#   - kosong / kurang dari 32 karakter (48 di production)
#   - masih berupa nilai placeholder di bawah ini
#   - ACCESS dan REFRESH bernilai sama
# Generate secret acak kuat (jalankan 2x, salin masing-masing):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-min-16-char"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-lain-min-16-char"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=10

# CORS — daftar origin frontend yang diizinkan, dipisah koma.
# Kosongkan di development untuk fallback otomatis ke http://localhost:3001.
CORS_ORIGINS="http://localhost:3001"

# Supabase Storage — WAJIB diisi (foto member diunggah ke sana, bukan ke disk).
# Ambil di dashboard: Settings → API Keys (secret / service_role key).
# Key ini BYPASS semua RLS → backend only, jangan pernah dipakai di web/.
# Nama bucket disalin persis dari Storage → Buckets (case-sensitive). Hindari
# spasi: nama bucket ikut tertanam di setiap photo_url yang tersimpan di DB, dan
# Supabase tidak punya operasi rename — menggantinya = membetulkan semua baris.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_STORAGE_BUCKET="member-photos"
# Bucket foto profil akun (users.photo_url) — dipisah dari foto member card.
# Buat sendiri di Storage → New bucket, centang PUBLIC. Opsional (default
# "avatar"); kalau bucket-nya belum ada, upload gagal 502 saat dipakai.
SUPABASE_AVATAR_BUCKET="avatar"

# Rate limiting (opsional; nilai di bawah adalah default bila tidak diset)
RATE_LIMIT_WINDOW_MS=900000   # 15 menit
RATE_LIMIT_MAX=300            # batas request per window untuk limiter global
AUTH_RATE_LIMIT_MAX=20        # batas request per window untuk endpoint auth
